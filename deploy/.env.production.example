# Docker image selection
GHCR_OWNER=147196421
LOOMIC_IMAGE_TAG=latest
LOOMIC_WEB_BIND_PORT=8925
LOOMIC_API_BIND_PORT=8926

# Public application URLs
LOOMIC_WEB_ORIGIN=https://app.example.com
NEXT_PUBLIC_SERVER_BASE_URL=https://api.example.com

# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_DB_URL=postgresql://postgres:replace-me@host:5432/postgres
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_JWT_SECRET=replace-me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Agent through an OpenAI-compatible NewAPI endpoint
LOOMIC_AGENT_BACKEND_MODE=state
LOOMIC_AGENT_MODEL=openai:replace-with-model-id
OPENAI_API_BASE=https://newapi.example.com/v1
OPENAI_API_KEY=replace-me

# Optional generation providers
GOOGLE_API_KEY=
REPLICATE_API_TOKEN=
METASO_API_KEY=
METASO_API_BASE=https://metaso.cn/api/minimax/
GOOGLE_FONTS_API_KEY=

# Worker limits
WORKER_CODE_CONCURRENCY=3
WORKER_IMAGE_CONCURRENCY=3
WORKER_VIDEO_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
